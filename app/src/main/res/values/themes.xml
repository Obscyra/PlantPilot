<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PlantPilot" parent="android:Theme.Material.NoActionBar">
        <!-- Main window background during app start -->
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
    </style>

    <style name="Theme.PlantPilot.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground_scaled</item>
        <item name="postSplashScreenTheme">@style/Theme.PlantPilot</item>
    </style>
</resources>
